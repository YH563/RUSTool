<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          目标框架跟仿真包对齐：RobotSimulation 0.3.1 的 lib 目录仍是 net8.0
          （库自己在提交 376a90f 把 net10.0 回退成了 net8.0，0.3.x 没有再动过），
          本解决方案随之整体留在 net8.0。
        -->
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- Silk.NET 的 GL 绑定签名里有裸指针（如 BufferData 的 void*），没有它编译不过。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 库工程，但只服务于本解决方案，不作为 NuGet 包发布。 -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
          3D 内核：RobotSimulation（见 README.md）。
            · Core   —— 场景图 / 几何 / 点云 / 渲染抽象（纯 CPU，零 GL）
            · Robot  —— URDF 解析 + 正运动学（纯 CPU）
            · OpenGL —— Silk.NET 后端（公开面不暴露任何 GL 类型）
          三者都不依赖 Avalonia，所以「把 GL 画进 Avalonia」这件事只发生在本项目里。

          版本 0.3.1 取自 nuget.org —— 0.1.0 / 0.2.0 / 0.2.1 / 0.3.0 / 0.3.1 都已发布在那边，仓库根的
          NuGet.config 把源钉成 nuget.org 一个（<clear /> 后显式 add），所以本工程
          不依赖任何本机离线目录：换机器 / 上 CI 开箱即可还原。
          （库的源码在 /home/hp/PersonalLibrary/RobotSimulation，tag 与包一一对应；
          查某个 API 的确切语义以那份源码为准，比只读 XML 注释快。）

          0.3.1 相对 0.3.0 只是补齐：Axes.AlwaysOnTop / GameObject.ShowLocalAxes —— 单个
          GameObject 的坐标系可以声明为「画在几何之上」（默认仍是 false，锁定默认值的用例在库的
          Tests/AxesDepthPolicyTests.cs），另含只影响发布的 CI 修复（符号包推送顺序与重试）。

          0.3.0 有两处变化，本工程都已跟进：
            · SceneGraph 线程契约收紧 —— 「场景图属主只声明一次」，点云数据（PointCloud2Data）
              的改动也只允许在属主线程上做。属主就是 构造场景图的那个线程：本工程在
              OnOpenGlInit 里建 RobotScene，Update / Render 也在同一条控件线程上，所以
              不需要 ClaimOwnership；点云帧从 WebSocket 线程进来时走 RobotViewport 已有的
              邮箱模式（关节值那条路的同款，见 SubmitPointCloud），绝不直接写场景图。
            · SceneGraph.OrientationGizmoSize 被移除 —— 朝向 gizmo 的尺寸改归渲染器
              （视口短边 × Renderer.GizmoSizeRatio 0.12，夹在 64~240 物理像素），场景那边只剩
              OrientationGizmoMargin。GizmoTopInset 因此从「把 gizmo 缩到覆盖层以下」变成
              「覆盖层下面放不下就不画」，见 RobotViewport.ApplyGizmoLayout。

          0.2.1 相对 0.2.0 只修一个缺陷：正运动学的乘法顺序 —— URDF 的 T_origin·R_axis(q)
          在行向量约定下必须写成 JointMotion * Origin（原来写反了），否则整条子链被摆偏。
          受不受影响看「关节旋转会不会带动 origin 的平移」：本模型的 j2（0.211 m）、j3（0.084）、
          j4（0.072）、j5（0.031）都错位（随机扫姿态时末端最大 1.1 m 量级），
          只有 j1（原点在原点）与 j6（原点平移恰与转轴平行）碰巧看不出来。

          0.2.0 相对 0.1.0 新增：屏幕空间朝向 gizmo（SceneGraph.ShowOrientationGizmo，库默认开启）、
          选中对象显示自身坐标系（SceneGraph.ShowSelectionAxes，库默认开启 —— 拾取走 PickAndSelect 即可见）、
          点云增量更新。
        -->
        <PackageReference Include="RobotSimulation.Core" Version="0.3.1" />
        <PackageReference Include="RobotSimulation.Robot" Version="0.3.1" />
        <PackageReference Include="RobotSimulation.OpenGL" Version="0.3.1" />

        <!--
          Logging/SimulationLogBridge.cs 直接把库的日志门面接到宿主日志出口上，
          用到 ILoggerProvider / ILogger（这两个类型也是库自身的日志抽象）。
          显式声明而不用「从 RobotSimulation.Core 传递过来」的隐式依赖：本项目确实在源码里用了它，
          版本与库引用的一致（10.0.11，有 net8.0 资产）。
        -->
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />

        <!--
          本项目唯一允许出现的界面依赖：Avalonia 提供 OpenGlControlBase（它会给我们一个
          GL 上下文和一个 framebuffer），Silk.NET.OpenGL 把 Avalonia 的过程地址包成 GL 门面。
          这两样【只在本工程内可见】，RUSTool.UI 引用本项目时不会传递出去
          （PackageReference 默认 PrivateAssets=compile 的传递行为：UI 仍能编译，但不该用、也没用）。
        -->
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    </ItemGroup>

    <!--
      测试/演示模型（URDF + mesh）随编译复制到输出目录，并被引用本项目的主程序一并带上，
      因此加载路径可以固定写 `AppContext.BaseDirectory/Assets/...`，
      与「从哪个工作目录启动程序」无关。见 Assets/Models/README.md。
    -->
    <ItemGroup>
        <None Remove="Assets\**\*" />
        <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
