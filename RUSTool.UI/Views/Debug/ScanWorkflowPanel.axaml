<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RUSTool.UI.ViewModels"
             xmlns:debug="using:RUSTool.UI.Views.Debug"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="350"
             x:Class="RUSTool.UI.Views.Debug.ScanWorkflowPanel"
             x:DataType="vm:ScanWorkflowViewModel">

    <!--
      扫查工作流：①预扫查 → ②位姿 → ③规划 → ④执行。

      布局：顶部状态条（当前阶段 / 下一步）→ 中部【四步流程 | 点动】并排 → 底部流程按钮。
      点动与「手动」面板共用同一个 RobotControlViewModel（JogAxes，按住走 / 松手停），
      且**只在①预扫查阶段**可用（建图时人工点动扫过体表）；其余阶段整体置灰（CanJog）。
      后端 start_jog 本就直连 driver、不受 set_mode 影响，所以扫查模式下也能点动。
      所有流程按钮的 IsEnabled 来自状态机 CanFire —— 与「点了能不能执行」同源。
    -->

    <Grid RowDefinitions="Auto,*,Auto" Margin="16,10">

        <!-- ── 状态条：当前阶段 + 下一步 ── -->
        <Border Background="{DynamicResource InfoSubtleBgBrush}"
                BorderBrush="{DynamicResource InfoSubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                <TextBlock Classes="caption" Text="当前阶段" />
                <TextBlock Grid.Column="2" Text="{Binding CurrentStage}"
                           FontWeight="{DynamicResource FontWeightSemiBold}" />
                <TextBlock Grid.Row="1" Classes="caption" Text="下一步" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="accent"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Text="{Binding NextAction}" />
            </Grid>
        </Border>

        <!-- ── 中部并排：左四步流程 / 右点动 ── -->
        <!-- 分隔线用 Auto 列：dividerVertical 带左右 12 的 Margin，固定 6px 列会溢出压到相邻列 -->
        <Grid Grid.Row="1" ColumnDefinitions="1.1*,Auto,1.05*" Margin="0,8,0,0">

            <!-- 右：点动（仅预扫查 / 位姿选点阶段） -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Classes="caption" Text="点动（预扫查 / 位姿选点）" TextWrapping="Wrap" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                    <TextBlock Classes="caption" Text="参考系" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" MinWidth="104"
                              ItemsSource="{Binding Control.JogFrames}"
                              SelectedIndex="{Binding Control.JogFrameIndex}" />
                </Grid>

                <ScrollViewer Grid.Row="2" Margin="0,4,0,0" IsEnabled="{Binding CanJog}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <debug:JogAxes DataContext="{Binding Control}" />
                </ScrollViewer>

                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,6,0,0"
                      IsEnabled="{Binding CanJog}">
                    <TextBlock Classes="caption" Text="速度" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="1" Maximum="100"
                            Value="{Binding Control.MotionSpeed}" />
                    <TextBlock Grid.Column="2" Classes="mono" Width="44" TextAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding Control.MotionSpeed, StringFormat='{}{0:F0}%'}" />
                </Grid>
            </Grid>

            <Rectangle Grid.Column="1" Classes="dividerVertical" Margin="12,0" />

            <!-- 左：四步流程状态灯 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanStep">
                            <Border Classes="sunken" Padding="10,4" Margin="0,2">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                    <!-- 步骤灯：待办 / 进行中 / 完成，三态互斥 -->
                                    <Ellipse Classes="dot"
                                             Classes.idle="{Binding IsPending}"
                                             Classes.info="{Binding IsActive}"
                                             Classes.success="{Binding IsDone}" />

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Index}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="{DynamicResource FontWeightSemiBold}" />
                                        </StackPanel>
                                        <TextBlock Classes="caption" Text="{Binding Hint}" />
                                    </StackPanel>

                                    <!-- 产物摘要：告诉用户这一步"做出了什么" -->
                                    <Border Grid.Column="2" Classes="tag neutral"
                                            IsVisible="{Binding HasDetail}">
                                        <TextBlock Text="{Binding Detail}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── 流程控制：横跨整卡 ── -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="6" Margin="0,8,0,0">
            <Button Classes="sm accent" Content="开始预扫查" IsEnabled="{Binding CanStartPreScan}"
                    Command="{Binding StartPreScanCommand}" />
            <Button Classes="sm" Content="结束预扫查" IsEnabled="{Binding CanEndPreScan}"
                    Command="{Binding EndPreScanCommand}" />
            <Button Classes="sm" Content="设为起点" IsEnabled="{Binding CanSetStart}"
                    Command="{Binding SetStartPoseCommand}" />
            <Button Classes="sm" Content="设为终点" IsEnabled="{Binding CanSetEnd}"
                    Command="{Binding SetEndPoseCommand}" />
            <Button Classes="sm" Content="开始规划" IsEnabled="{Binding CanPlan}"
                    Command="{Binding PlanCommand}" />
            <Button Classes="sm accent" Content="执行" IsEnabled="{Binding CanExecute}"
                    Command="{Binding ExecuteCommand}" />
            <Button Classes="sm" Content="暂停" IsEnabled="{Binding CanPause}"
                    Command="{Binding PauseCommand}" />
            <Button Classes="sm" Content="恢复" IsEnabled="{Binding CanResume}"
                    Command="{Binding ResumeCommand}" />
            <Button Classes="sm danger" Content="停止" IsEnabled="{Binding CanStop}"
                    Command="{Binding StopCommand}" />
            <Button Classes="sm" Content="复位" IsEnabled="{Binding CanReset}"
                    Command="{Binding ResetCommand}" />
            <Button Classes="sm ghost" Content="刷新状态"
                    Command="{Binding RefreshStatusCommand}" />
        </WrapPanel>
    </Grid>
</UserControl>
