<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RUSTool.UI.ViewModels"
             xmlns:debug="using:RUSTool.UI.Views.Debug"
             xmlns:charts="using:RUSTool.Charts.Controls"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="850"
             x:Class="RUSTool.UI.Views.Debug.DebugWorkspace"
             x:DataType="vm:MainViewModel">

    <!--
      工程师工作区：上排 3 块（3D / 影像 / 曲线）+ 下排 3 块（指令 / 回放 / 日志）。

      每块卡片用 Classes="card"、卡片头用 Classes="cardHeader"（自带 40 高与底边线）——
      "底色 + 阴影 + 圆角 + 分隔线"四件事一处定义、六处复用，改一次全局生效。
    -->

    <Grid RowDefinitions="*,Auto" Margin="16,12">

        <!-- ═══ 上排：3D / 影像 / 曲线 ═══ -->
        <Grid ColumnDefinitions="3*,6,2*,6,2*">

            <Border Classes="card" MinWidth="320">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelTitle" Text="3D 场景" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="视角 默认" />
                        </Grid>
                    </Border>
                    <!--
                      卡片内容就是一整块 3D 视口：机械臂状态读数不再占视口旁边的一列
                      （那样是按卡片宽度的比例吃掉 3D 的面积），改成叠在视口右上角、
                      按需展开的浮层 —— 不按就没有。

                      卡片 MinWidth 320 = 视口本身的可看下限（~196）+ 状态浮层不参与布局，
                      所以下限定得比「停靠一列」那一版（520）低得多。
                    -->
                    <Grid Grid.Row="1">
                        <debug:Scene3DView />
                        <!--
                          右上角一列：上面是开关，下面是展开出来的读数浮层。

                          StackPanel 自己没有底色 → 这一整块【不参与命中测试】，
                          只有开关那一小块会挡住相机操作；读数浮层自己是
                          IsHitTestVisible=False 的，左键转 / 中键平移 / 右键缩放
                          都可以直接穿过它继续用。

                          Margin 12 = 贴视口边内衬；Spacing 8 = 开关与浮层之间留一道缝，
                          两者挨在一起会看成同一块东西。
                        -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="12" Spacing="8">

                            <!--
                              半透明开关：底色用 0.9 不透明的卡片色而不是全透明。
                              原因是场景本身是深灰（SceneGraph.BackgroundColor），
                              浅色主题下 ghost 按钮的文字直接压上去会糊在背景里；
                              垫一层卡片底之后，浅色主题 = 白底、深色主题 = 墨底，
                              两种主题下都读得清，又只占一枚按钮的位置。
                            -->
                            <Border HorizontalAlignment="Right"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMd}"
                                    BoxShadow="{DynamicResource ShadowSm}"
                                    Opacity="0.9">
                                <Button Classes="ghost sm"
                                        Content="{Binding Status.PanelToggleText}"
                                        Command="{Binding Status.TogglePanelCommand}"
                                        ToolTip.Tip="显示 / 隐藏机械臂状态读数" />
                            </Border>

                            <!-- 读数浮层：收起时整块不存在（IsVisible=false），不占任何地方。
                                 外面这层 Border 只为把 DataContext 换成 Status ——
                                 它自己没有底色，所以不会挡相机操作。 -->
                            <Border IsVisible="{Binding Status.IsPanelVisible}">
                                <debug:RobotStatusOverlay DataContext="{Binding Status}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <Border Grid.Column="2" Classes="card" MinWidth="220">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <TextBlock Classes="panelTitle" Text="超声影像" />
                    </Border>
                    <debug:UltrasoundView Grid.Row="1" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" />

            <Border Grid.Column="4" Classes="card" MinWidth="220">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <!-- 窗口长度标在卡片头上（和 3D 卡的「视角 默认」同一个位置）：
                             放进面板里会白白吃掉一行的位置，而面板里的每一行都很贵。 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelTitle" Text="数据曲线" />
                            <TextBlock Grid.Column="1" Classes="caption"
                                       Text="{Binding Charts.WindowCaption}" />
                        </Grid>
                    </Border>
                    <!--
                      卡片体就是图表库的控件本身 —— 本层不再套一层「卡片体薄壳」文件：
                      六条曲线的配色 / 坐标轴 / 主题跟随 / 点集合的就地滚动全在 RUSTool.Charts 里，
                      本文件不认识 LiveCharts / SkiaSharp（与 3D 那侧把 Silk.NET / OpenGL 关在
                      RUSTool.Visualization 里是同一种做法）。

                      两个绑定就是全部接口：
                        Rows        —— 要画哪些行（行模型由 ViewModel 从通道目录建，见 TorqueChartViewModel）
                        IsConnected —— 只影响「没有数据」时那句话的措辞（没连上 / 连上了但还没来帧）

                      行头是「色标 + 通道名 + 读数」；行高由面板按卡片体的高度等分（六行铺满，不再留白），
                      没数据时的措辞随 IsConnected 变。数据本来也不在这里：
                      点由 RobotStateRow.Values 提供，超窗口删头与清空重填是数据层的事。
                    -->
                    <charts:RobotStatePanel Grid.Row="1"
                                            Rows="{Binding Charts.Rows}"
                                            IsConnected="{Binding Charts.IsConnected}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 下排：指令 / 回放 / 日志 ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="1.8*,6,1.3*,6,1*" Height="380" Margin="0,12,0,0">

            <!-- 机器人指令：同一状态机的两个投影（手动 / 扫查），用 Carousel 切换 -->
            <Border Classes="card" MinWidth="280">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelTitle" Text="机器人指令" />
                            <ComboBox Grid.Column="1" MinWidth="112"
                                      SelectedIndex="{Binding RobotModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="手动模式" />
                                <ComboBoxItem Content="扫查模式" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Carousel Grid.Row="1" SelectedIndex="{Binding RobotModeIndex}">
                        <debug:ArmControlPanel DataContext="{Binding Control}" />
                        <debug:ScanWorkflowPanel DataContext="{Binding Scan}" />
                    </Carousel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <Border Grid.Column="2" Classes="card" MinWidth="220">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <TextBlock Classes="panelTitle" Text="回放" />
                    </Border>
                    <debug:ReplayModule Grid.Row="1" DataContext="{Binding Replay}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" />

            <Border Grid.Column="4" Classes="card" MinWidth="240">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="panelTitle" Text="日志" />
                                <Border Classes="tag neutral">
                                    <TextBlock Text="{Binding Log.Entries.Count, StringFormat='{}{0} 条'}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <CheckBox Content="只看警告" IsChecked="{Binding Log.WarningOnly}"
                                          VerticalAlignment="Center" />
                                <Button Classes="sm ghost" Content="清空"
                                        Command="{Binding Log.ClearCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <debug:LogView Grid.Row="1" DataContext="{Binding Log}" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
