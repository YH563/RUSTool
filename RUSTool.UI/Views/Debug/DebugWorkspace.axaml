<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RUSTool.UI.ViewModels"
             xmlns:debug="using:RUSTool.UI.Views.Debug"
             xmlns:charts="using:RUSTool.Charts.Controls"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="850"
             x:Class="RUSTool.UI.Views.Debug.DebugWorkspace"
             x:DataType="vm:MainViewModel">

    <!--
      工程师工作区：上排 3 块（3D / 影像 / 曲线）+ 下排 3 块（指令 / 回放 / 日志）。

      每块卡片用 Classes="card"、卡片头用 Classes="cardHeader"（自带 40 高与底边线）——
      "底色 + 阴影 + 圆角 + 分隔线"四件事一处定义、六处复用，改一次全局生效。
    -->

    <!--
      上下排高度改用比例 + 可拖拽的行分隔，而不是把下排写死 380：
      小窗口（MinHeight 720）时上排不被压瘪、大窗口时增量也能分给下排，
      用户还能自己拖到顺手的位置。行分隔只是一个 8px 的透明热区。
    -->
    <!--
      行结构：上排 * ─ 行分隔 ─ 下排 * ─ 回放条（Auto）。
      回放从下排的一整张卡片改成底部一条全宽传输条：时间轴可以拉长、控件挤在一行里，
      信息密度高、也不再把下排的空间白白占掉（它此刻还是演示数据）。
    -->
    <Grid RowDefinitions="1.15*,8,*,Auto" Margin="16,12">

        <!-- ═══ 上排：3D / 影像 / 曲线 ═══ -->
        <Grid ColumnDefinitions="3*,6,2*,6,2*" MinHeight="280">

            <Border Classes="card" MinWidth="320">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                            <TextBlock Classes="panelTitle" Text="3D 场景" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="视角 默认" />
                            <CheckBox Grid.Column="2" Content="点云" Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowPointCloud}" />
                            <CheckBox Grid.Column="3" Content="重建" Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowPcMap}" />
                            <CheckBox Grid.Column="4" Content="网格" Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowMesh}" />
                        </Grid>
                    </Border>
                    <!--
                      卡片内容就是一整块 3D 视口：机械臂状态读数不再占视口旁边的一列
                      （那样是按卡片宽度的比例吃掉 3D 的面积），改成叠在视口右上角、
                      按需展开的浮层 —— 不按就没有。

                      卡片 MinWidth 320 = 视口本身的可看下限（~196）+ 状态浮层不参与布局，
                      所以下限定得比「停靠一列」那一版（520）低得多。
                    -->
                    <Grid Grid.Row="1">
                        <debug:Scene3DView ShowPointCloud="{Binding ShowPointCloud}" />
                        <!--
                          右上角一列：上面是开关，下面是展开出来的读数浮层。

                          StackPanel 自己没有底色 → 这一整块【不参与命中测试】，
                          只有开关那一小块会挡住相机操作；读数浮层自己是
                          IsHitTestVisible=False 的，左键转 / 中键平移 / 右键缩放
                          都可以直接穿过它继续用。

                          Margin 12 = 贴视口边内衬；Spacing 8 = 开关与浮层之间留一道缝，
                          两者挨在一起会看成同一块东西。
                        -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="12" Spacing="8">

                            <!--
                              半透明开关：底色用 0.9 不透明的卡片色而不是全透明。
                              原因是场景本身是深灰（SceneGraph.BackgroundColor），
                              浅色主题下 ghost 按钮的文字直接压上去会糊在背景里；
                              垫一层卡片底之后，浅色主题 = 白底、深色主题 = 墨底，
                              两种主题下都读得清，又只占一枚按钮的位置。
                            -->
                            <Border HorizontalAlignment="Right"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMd}"
                                    BoxShadow="{DynamicResource ShadowSm}"
                                    Opacity="0.9">
                                <Button Classes="ghost sm"
                                        Content="{Binding Status.PanelToggleText}"
                                        Command="{Binding Status.TogglePanelCommand}" />
                            </Border>

                            <!-- 读数浮层：收起时整块不存在（IsVisible=false），不占任何地方。
                                 外面这层 Border 只为把 DataContext 换成 Status ——
                                 它自己没有底色，所以不会挡相机操作。 -->
                            <Border IsVisible="{Binding Status.IsPanelVisible}">
                                <debug:RobotStatusOverlay DataContext="{Binding Status}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <Border Grid.Column="2" Classes="card" MinWidth="220">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <TextBlock Classes="panelTitle" Text="超声影像" />
                    </Border>
                    <debug:UltrasoundView Grid.Row="1" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" />

            <Border Grid.Column="4" Classes="card" MinWidth="220">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <!-- 窗口长度标在卡片头上（和 3D 卡的「视角 默认」同一个位置）：
                             放进面板里会白白吃掉一行的位置，而面板里的每一行都很贵。 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelTitle" Text="数据曲线" />
                            <TextBlock Grid.Column="1" Classes="caption"
                                       Text="{Binding Charts.WindowCaption}" />
                        </Grid>
                    </Border>
                    <!--
                      卡片体就是图表库的控件本身 —— 本层不再套一层「卡片体薄壳」文件：
                      六条曲线的配色 / 坐标轴 / 主题跟随 / 点集合的就地滚动全在 RUSTool.Charts 里，
                      本文件不认识 LiveCharts / SkiaSharp（与 3D 那侧把 Silk.NET / OpenGL 关在
                      RUSTool.Visualization 里是同一种做法）。

                      两个绑定就是全部接口：
                        Rows        —— 要画哪些行（行模型由 ViewModel 从通道目录建，见 TorqueChartViewModel）
                        IsConnected —— 只影响「没有数据」时那句话的措辞（没连上 / 连上了但还没来帧）

                      行头是「色标 + 通道名 + 读数」；行高由面板按卡片体的高度等分（六行铺满，不再留白），
                      没数据时的措辞随 IsConnected 变。数据本来也不在这里：
                      点由 RobotStateRow.Values 提供，超窗口删头与清空重填是数据层的事。
                    -->
                    <charts:RobotStatePanel Grid.Row="1"
                                            Rows="{Binding Charts.Rows}"
                                            IsConnected="{Binding Charts.IsConnected}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 行分隔：上下排之间可拖拽 -->
        <GridSplitter Grid.Row="1" Classes="horizontal" ResizeDirection="Rows" />

        <!-- ═══ 下排：指令 / 日志（回放已移到最底部的全宽传输条） ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="1.6*,6,1*" MinHeight="240">

            <!-- 机器人指令：同一状态机的两个投影（手动 / 扫查），用 Carousel 切换 -->
            <Border Classes="card" MinWidth="280">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelTitle" Text="机器人指令" />
                            <!-- 手动 / 扫查：分段标签（一眼看出这是"切页"，一次点击到位），
                                 比原来的下拉少一次点击，也更像标签页而不是选项选择。 -->
                            <!-- sm 尺寸：卡片头 40 高，32 高的按钮只剩 4px，太小；26 高上下各留 7px -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Classes="segLeft sm" Content="手动"
                                        Command="{Binding SelectRobotModeCommand}" CommandParameter="0"
                                        Classes.segOn="{Binding IsManualMode}" />
                                <Button Classes="segRight sm" Content="扫查"
                                        Command="{Binding SelectRobotModeCommand}" CommandParameter="1"
                                        Classes.segOn="{Binding IsScanMode}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 回放播放中：手动 / 扫查两个面板整体置灰（它们都是后端指令，此时后端已被接管断开） -->
                    <Carousel Grid.Row="1" SelectedIndex="{Binding RobotModeIndex}"
                              IsEnabled="{Binding Replay.CanUseBackend}">
                        <debug:ArmControlPanel DataContext="{Binding Control}" />
                        <debug:ScanWorkflowPanel DataContext="{Binding Scan}" />
                    </Carousel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <Border Grid.Column="2" Classes="card" MinWidth="240">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="cardHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="panelTitle" Text="日志" />
                                <Border Classes="tag neutral">
                                    <TextBlock Text="{Binding Log.Entries.Count, StringFormat='{}{0} 条'}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <!-- 自动滚动可关：关掉后新日志不再把列表拽到底，方便回看历史 -->
                                <CheckBox Content="自动滚动" IsChecked="{Binding Log.AutoScroll}"
                                          VerticalAlignment="Center" />
                                <CheckBox Content="只看警告" IsChecked="{Binding Log.WarningOnly}"
                                          VerticalAlignment="Center" />
                                <CheckBox Content="调试" IsChecked="{Binding Log.IncludeDebug}"
                                          VerticalAlignment="Center" />
                                <Button Classes="sm ghost" Content="清空"
                                        Command="{Binding Log.ClearCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <debug:LogView Grid.Row="1" DataContext="{Binding Log}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 回放条：本地回放（前端直读 .rusrec，不经后端） ═══
             目录来自设置（可编辑 / 选择目录），文件升序=时间顺序；载入后本地播放。
             首次播放前会"接管"：确保不运动 → 断开后端 → 独占 HUD/曲线/3D。 -->
        <Border Grid.Row="3" Classes="card" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10"
                  Margin="16,6" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="panelTitle" Text="回放" />
                <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                           Text="{Binding Replay.StatusText}" />

                <!-- 录音目录（可编辑，写入设置；与后端 recorder 的 output_dir 指向同一绝对目录） -->
                <TextBox Grid.Column="2" MinWidth="200" MaxWidth="300" VerticalAlignment="Center"
                         Text="{Binding Settings.RecordsDirectory}" />
                <!-- 整条回放条统一 32 高。左侧控件【必须】显式 VerticalAlignment=Center：
                     行高被右侧传输条的滑块撑高后，默认 Stretch 的按钮会被拉长（主操作尤其明显）。 -->
                <Button Grid.Column="3" Content="选择目录" VerticalAlignment="Center"
                        Click="OnReplayPickDirectory" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Button Content="刷新" VerticalAlignment="Center"
                            Command="{Binding Replay.RefreshListCommand}" />
                    <ComboBox MinWidth="150" MaxWidth="220" VerticalAlignment="Center"
                              ItemsSource="{Binding Replay.Files}"
                              SelectedIndex="{Binding Replay.SelectedFileIndex}"
                              PlaceholderText="（无录音）" />
                    <Button Classes="accent" Content="载入" VerticalAlignment="Center"
                            Command="{Binding Replay.LoadSelectedCommand}" />
                    <Button Content="打开…" VerticalAlignment="Center" Click="OnReplayOpen" />
                </StackPanel>

                <!-- 未载入：一句提示；已载入：整条传输控件 -->
                <TextBlock Grid.Column="5" Classes="caption" VerticalAlignment="Center"
                           IsVisible="{Binding Replay.IsDataEmpty}"
                           Text="选目录 → 刷新 → 载入，再播放（播放前会断开后端连接）" />
                <debug:ReplayModule Grid.Column="5" DataContext="{Binding Replay}"
                                    IsVisible="{Binding IsLoaded}" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
