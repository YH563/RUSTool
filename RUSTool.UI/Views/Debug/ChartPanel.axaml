<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:Class="RUSTool.UI.Views.Debug.ChartPanel">

    <UserControl.Resources>
        <!--
          数据通道配色。

          为什么这几个 hex【不放】进主题库、也不换成语义色：
            Fx / Fy / Fz 红绿蓝是**工程惯例**（和 XYZ 轴同义），
            它是"这条曲线代表什么"，而不是"这个控件处于什么状态"。
            换配色方案时曲线颜色不该跟着变，否则整张图的含义就变了。

          所以它们集中定义在这里：既有唯一来源，又与主题解耦 ——
          想统一调一次只改这一处，不用去翻 7 个 CheckBox。
        -->
        <SolidColorBrush x:Key="ChFx" Color="#F04438" />
        <SolidColorBrush x:Key="ChFy" Color="#12B76A" />
        <SolidColorBrush x:Key="ChFz" Color="#2E90FA" />
        <SolidColorBrush x:Key="ChTx" Color="#F79009" />
        <SolidColorBrush x:Key="ChTy" Color="#9E77ED" />
        <SolidColorBrush x:Key="ChTz" Color="#06AED4" />
        <SolidColorBrush x:Key="ChDev" Color="#EAAA08" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- 通道显隐切换 -->
        <WrapPanel Margin="16,8" ItemSpacing="16">
            <CheckBox Content="Fx" IsChecked="True" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChFx}" />
            <CheckBox Content="Fy" IsChecked="True" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChFy}" />
            <CheckBox Content="Fz" IsChecked="True" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChFz}" />
            <CheckBox Content="Tx" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChTx}" />
            <CheckBox Content="Ty" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChTy}" />
            <CheckBox Content="Tz" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChTz}" />
            <CheckBox Content="偏差" IsCheckedChanged="OnChannelToggled"
                      Foreground="{StaticResource ChDev}" />
        </WrapPanel>

        <!-- 曲线绘制区域 -->
        <Border Grid.Row="1" Classes="canvas" Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid>
                <!--
                  曲线元素在 XAML 里声明（颜色因此只有一处来源），
                  代码后置只负责往 Points 里填点。
                  Viewbox 固定内部坐标系 400x160，缩放交给它。
                -->
                <Viewbox Stretch="Fill" Margin="14">
                    <Canvas Width="400" Height="160">
                        <!-- 基线：让信号看起来是"围绕某个值波动" -->
                        <Line x:Name="BaseFx" StartPoint="0,80" EndPoint="400,80"
                              Stroke="{StaticResource ChFx}" StrokeThickness="1" Opacity="0.25" />
                        <Polyline x:Name="WaveFx" Stroke="{StaticResource ChFx}" StrokeThickness="1.6" />
                        <Line x:Name="BaseFy" StartPoint="0,80" EndPoint="400,80"
                              Stroke="{StaticResource ChFy}" StrokeThickness="1" Opacity="0.25" />
                        <Polyline x:Name="WaveFy" Stroke="{StaticResource ChFy}" StrokeThickness="1.6" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
