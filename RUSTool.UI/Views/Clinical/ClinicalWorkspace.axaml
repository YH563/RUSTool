<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RUSTool.UI.ViewModels"
             xmlns:debug="using:RUSTool.UI.Views.Debug"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="850"
             x:Class="RUSTool.UI.Views.Clinical.ClinicalWorkspace"
             x:DataType="vm:MainViewModel">

    <!--
      临床工作区。按 docs/ui/zh-CN.md 第 6 节的设计稿搭出来，
      顺便验证主题在"大字号、少控件、触控友好"场景下的表现。

      与工程师模式的差别（设计文档的核心主张）：
        · 只暴露一条线性流水线 + 急停，没有点动 6 轴、没有原始回执、没有日志；
        · 字号更大（读数用 metric 类 = 28 号）、按钮更高（lg = 38）；
        · 状态用三色灯表达，数值只留一个临床最关心的"末端接触力"。
    -->

    <UserControl.Styles>
        <!-- 步骤行：字号放大、当前步用主色底描边，触控更友好（临床场景的核心主张） -->
        <Style Selector="Border.step">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.step.active">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.stepTitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
        </Style>
</UserControl.Styles>

    <Grid ColumnDefinitions="*,6,340" Margin="16,12">

        <!-- ═══ 左：主视图 = 超声影像（临床主内容）+ 左下角 3D 画中画 ═══ -->
        <Border Classes="card">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="cardHeader">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="panelTitle" Text="超声影像" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot"
                                         Classes.success="{Binding Session.IsConnected}"
                                         Classes.idle="{Binding Session.IsIdle}" />
                                <TextBlock Classes="caption" Text="{Binding Session.ConnectText}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot"
                                         Classes.idle="{Binding Session.IsIdle}"
                                         Classes.info="{Binding Session.IsManual}"
                                         Classes.warning="{Binding Session.IsScanning}"
                                         Classes.danger="{Binding Session.IsHalted}" />
                                <TextBlock Classes="caption" Text="{Binding Session.ModeText}" />
                            </StackPanel>

                            <Border Classes="tag">
                                <TextBlock Text="{Binding Scan.CurrentStage}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主视图分栏：超声（主）| 3D 场景（点云 / 重建网格 / 探头位姿）。
                     两栏用 GridSplitter 分隔、可拖拽；3D 视口与工程师工作区互斥挂树，
                     仍是"同一时刻只有一个 3D 视口"。 -->
                <Grid Grid.Row="1" ColumnDefinitions="5*,6,4*">
                    <!-- ① 超声影像：临床主内容，占主栏 -->
                    <debug:UltrasoundView Grid.Column="0" />

                    <GridSplitter Grid.Column="1" />

                    <!-- ② 3D 场景：点云、重建网格、探头位姿都看这里 —— 必须有足够尺寸，
                         所以用分栏而不是小画中画。 -->
                    <Border Grid.Column="2"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1,0,0,0"
                            ClipToBounds="True">
                        <debug:Scene3DView />
                    </Border>

                    <!-- ③ 临床 HUD 只留一项：末端接触力（用 metric 大读数），叠在【3D 视图】右上角 ——
                         接触力是机械臂末端的量，理应贴着 3D 场景看，而不是压在超声图像上。 -->
                    <Border x:Name="ContactForceOverlay" Grid.Column="2"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}"
                            BoxShadow="{DynamicResource ShadowMd}"
                            Padding="14,10"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="末端接触力" />
                            <TextBlock Classes="metric"
                                       Text="{Binding Status.ContactForce, StringFormat='{}{0:F1} N'}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" />

        <!-- ═══ 右：步骤向导（临床的心智模型就是这条流水线） ═══ -->
        <Border Grid.Column="2" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                <Border Classes="cardHeader">
                    <TextBlock Classes="panelTitle" Text="扫查流程" />
                </Border>

                <!-- 患者信息 -->
                <Border Grid.Row="1" Classes="sunken" Margin="16,12,16,0" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="4" ColumnSpacing="10">
                        <TextBlock Classes="caption" Text="姓名" />
                        <TextBlock Grid.Column="1" Text="示例患者"
                                   FontWeight="{DynamicResource FontWeightSemiBold}" />
                        <TextBlock Grid.Row="1" Classes="caption" Text="检查号" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono"
                                   Text="US-20260913-0042" />
                        <TextBlock Grid.Row="2" Classes="caption" Text="部位" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="腹部（肝右叶）" />
                    </Grid>
                </Border>

                <!-- 4 步：与工程师模式共用同一份状态机数据（只是投影不同） -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Scan.Steps}" Margin="16,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanStep">
                            <Border Classes="step" Classes.active="{Binding IsActive}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Classes="dot"
                                             Classes.idle="{Binding IsPending}"
                                             Classes.info="{Binding IsActive}"
                                             Classes.success="{Binding IsDone}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Classes="stepTitle" Text="{Binding Title}" />
                                        <TextBlock Classes="caption" Text="{Binding Hint}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center"
                                               Text="{Binding Detail}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 下一步：主操作，按钮文案直接说"该做什么"（向导感的关键）。
                     MinHeight 48 —— 临床场景触控友好，比工程师侧的 38 更高一档。 -->
                <StackPanel Grid.Row="3" Spacing="8" Margin="16,0,16,10">
                    <Button Classes="accent lg" MinHeight="48"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{Binding Scan.NextAction}"
                            Command="{Binding Scan.ExecuteCommand}" />

                    <!-- 停止 / 复位：都是运动级操作，给足尺寸、危险操作用 danger -->
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="danger lg" Content="停止"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding Scan.StopCommand}" />
                        <Button Grid.Column="2" Classes="lg" Content="复位"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding Scan.ResetCommand}" />
                    </Grid>
                </StackPanel>

                <!-- 安全：急停永远可达；恢复只在急停后可用（未急停时置灰挡误操作） -->
                <Grid Grid.Row="4" ColumnDefinitions="*,8,*" Margin="16,0,16,16">
                    <Button Classes="danger lg" Content="急停"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            FontWeight="{DynamicResource FontWeightBold}"
                            Command="{Binding Session.EmergencyStopCommand}" />
                    <Button Grid.Column="2" Classes="success lg" Content="急停恢复"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            FontWeight="{DynamicResource FontWeightBold}"
                            IsEnabled="{Binding Session.IsEmergencyStopped}"
                            Command="{Binding Session.ResetEmergencyCommand}" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
