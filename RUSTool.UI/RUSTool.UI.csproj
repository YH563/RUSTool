<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- 目标框架与 RUSTool.Core / RUSTool.Visualization（以及它们引用的仿真包）保持一致：net8.0。 -->
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!--
          命名空间 / 程序集都叫 RUSTool.UI：
          界面代码统一落在 RUSTool.UI.* 下，纯逻辑层的命名空间保持 RUSTool.*。
          设计系统（令牌 + 控件样式）也在本项目内，见 Theme/ —— 只含 XAML 资源，
          不产出 C# 类型，所以不再单独拆一个主题工程。
        -->
        <RootNamespace>RUSTool.UI</RootNamespace>
        <AssemblyName>RUSTool.UI</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- 应用程序，不参与打包 -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- 应用图标等静态资源打进程序集 -->
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!--
          依赖方向单向：RUSTool.UI（界面）→ RUSTool.Core（纯逻辑）。

          Core 提供：bridge 通信协议 / 传输、机器人业务服务、服务契约
          （IRobotService / ILogService / RobotSession / BridgeProtocol）。
          Core 不引用 Avalonia，也不反向引用本项目 —— 界面的东西全部留在这一层。

          设计系统（Theme/ 下的令牌 + 控件样式）已并入本项目：
          它只含 XAML 资源、不产出任何 C# 类型，单独成工程反而多一层引用。
        -->
        <ProjectReference Include="..\RUSTool.Core\RUSTool.Core.csproj" />
        <!--
          3D 图形栈的隔离容器。界面只认识它两个契约：RobotViewport（控件，数据入口是纯 float 列表）
          与 ISimulationLogSink / SimulationLogBridge（日志出口，只有 1 个方法 + 4 档枚举）。
          Silk.NET / OpenGL / RobotSimulation 全部关在那个工程里，不进入本项目。
        -->
        <ProjectReference Include="..\RUSTool.Visualization\RUSTool.Visualization.csproj" />
        <!--
          2D 图表栈的隔离容器（曲线面板）。界面只认识它的两个契约：
          RobotStatePanel（控件，数据入口是行集合 + 纯 double 列表）与 RobotStateRow / RobotArmChannels
          （行模型 + 通道目录）。LiveCharts / SkiaSharp / 曲线配色全部关在那个工程里，不进入本项目。
        -->
        <ProjectReference Include="..\RUSTool.Charts\RUSTool.Charts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <!-- 开发期离屏截图：不开窗、没有显示器也能把界面渲染成 PNG（见 preview.sh） -->
        <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
        <!-- MVVM 源生成器（ObservableProperty / RelayCommand），与主程序保持同版本 -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

</Project>
