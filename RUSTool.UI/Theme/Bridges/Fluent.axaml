<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
    ════════════════════════════════════════════════════════════════════════════
      Fluent 桥接层 —— 把 Fluent 主题的"资源键"重定向到本项目的设计令牌
    ════════════════════════════════════════════════════════════════════════════

      为什么用这种方式，而不是逐个重写控件模板？
        Fluent 主题已经把几乎所有可配置项抽成了资源键
        （TextControlBackground、ComboBoxBorderBrush、CheckBoxCheckBackgroundFillChecked…），
        模板本身只是引用这些键。所以只要覆盖键值就能整体换肤：

          ✅ 不碰模板内部 → 不必知道 PART_XXX 的名字，也不会和模板抢优先级
          ✅ 覆盖更全   → disabled / pressed / indeterminate 这类边角状态一并改掉
          ✅ 更抗升级   → 只要 Fluent 不改键名，外观就不会坏
          ✅ 一处生效   → 旧代码里"某个输入框漏改颜色"的问题从根上消失

      与 Controls/*.axaml 的分工：
        · 本文件：把 Fluent 自带控件染成我们的配色
        · Controls/*：提供 Fluent 没有的能力（按钮 accent/danger 变体、文字语义类）

      ⚠ 必须在 FluentTheme 之后加载本主题，否则这些键会被 Fluent 默认值盖回去。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ════════════════════════════════════════════════════════════════
             浅色主题
             ════════════════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Light">

            <!-- ═══ TextBox / 文本输入 ═══
                 常驻白底；描边用 Neutral300（与按钮一致，可点击性才明确）；
                 聚焦只换描边颜色，粗细保持 1px。 -->
            <SolidColorBrush x:Key="TextControlBackground"             Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled"     Color="{StaticResource PaletteNeutral100}" />

            <SolidColorBrush x:Key="TextControlBorderBrush"            Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled"    Color="{StaticResource PaletteNeutral150}" />

            <SolidColorBrush x:Key="TextControlForeground"             Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver"  Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused"      Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled"     Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled"    Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource PalettePrimary200}" />

            <!-- 聚焦时边框仍为 1px：Fluent 默认会从 1px 跳到 2px，导致文字聚焦瞬间位移 -->
            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <Thickness x:Key="TextControlThemePadding">10,6</Thickness>
            <sys:Double x:Key="TextControlThemeMinHeight">32</sys:Double>

            <!-- ═══ ComboBox ═══
                 下拉浮层用 SurfaceRaised（浅色下也是白，深色下才是"浮起"的灰），
                 选中项用 AccentSubtle 而不是旧的纯灰底 —— 一眼能看出"当前选的是哪个"。 -->
            <SolidColorBrush x:Key="ComboBoxBackground"                     Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"            Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"          Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed"              Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"             Color="{StaticResource PaletteNeutral100}" />

            <SolidColorBrush x:Key="ComboBoxBorderBrush"                    Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver"         Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"             Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled"            Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused"   Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource PaletteNeutral300}" />

            <SolidColorBrush x:Key="ComboBoxForeground"                     Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver"          Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed"              Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused"              Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed"       Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled"             Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="ComboBoxDropDownBackground"              Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush"             Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground"         Color="{StaticResource PaletteNeutral600}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused"  Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="ComboBoxItemBackground"                    Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"         Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed"             Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"            Color="{StaticResource PalettePrimary50}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource PalettePrimary100}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed"     Color="{StaticResource PalettePrimary100}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled"            Color="Transparent" />

            <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>

            <!-- ═══ CheckBox ═══
                 勾选框：未选中 = 白底灰边，选中 = 主色实心。
                 控件整体背景始终透明 —— 旧代码里勾选项带灰底，几个排在一起就显得脏。 -->
            <SolidColorBrush x:Key="CheckBoxBackgroundUnchecked"            Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPressed"     Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedDisabled"    Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundChecked"              Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPointerOver"   Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPressed"       Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedDisabled"      Color="Transparent" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked"              Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"   Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"       Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled"      Color="{StaticResource PaletteNeutral100}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"            Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"     Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled"    Color="{StaticResource PaletteNeutral150}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked"                Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver"     Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed"         Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled"        Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked"              Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver"   Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed"       Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled"      Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="CheckBoxCheckGlyphFill"         Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphFillDisabled" Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="CheckBoxForeground"             Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver"  Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundPressed"      Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundDisabled"     Color="{StaticResource PaletteNeutral400}" />

            <!-- ═══ RadioButton ═══ -->
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill"                     Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver"          Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPressed"              Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillDisabled"             Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke"                   Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver"        Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed"            Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeDisabled"           Color="{StaticResource PaletteNeutral150}" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill"              Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver"   Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed"       Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled"      Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke"            Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed"     Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled"    Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill"                       Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver"            Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed"                Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled"               Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="RadioButtonForeground"                           Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundPointerOver"                Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundPressed"                    Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundDisabled"                   Color="{StaticResource PaletteNeutral400}" />

            <!-- ═══ Slider ═══
                 已走过的轨道 = 主色，未走 = Neutral200，滑块 = 主色。
                 旧代码只设了 BorderBrush，等于没管，滑块颜色一直是 Fluent 默认蓝。 -->
            <SolidColorBrush x:Key="SliderTrackFill"                 Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver"      Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SliderTrackFillPressed"          Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled"         Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="SliderTrackValueFill"            Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed"     Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled"    Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="SliderThumbBackground"           Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed"    Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled"   Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="SliderTickBarFill"               Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="SliderTickBarFillDisabled"       Color="{StaticResource PaletteNeutral200}" />
            <CornerRadius x:Key="SliderThumbCornerRadius">9</CornerRadius>

            <!-- ═══ ScrollBar ═══
                 细、无底槽、悬停才加深 —— 滚动条不该抢注意力。 -->
            <SolidColorBrush x:Key="ScrollBarBackground"             Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver"  Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarForeground"             Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="ScrollBarThumbFill"              Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver"   Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed"       Color="{StaticResource PaletteNeutral600}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled"      Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ScrollBarButtonBackground"       Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground"  Color="{StaticResource PaletteNeutral600}" />

            <!-- ═══ ToolTip ═══
                 深底浅字的气泡：浅色界面里只有提示气泡用反色，对比最强且不干扰阅读。 -->
            <SolidColorBrush x:Key="ToolTipBackground"  Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ToolTipForeground"  Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource PaletteNeutral800}" />

            <!-- ═══ Menu / 下拉菜单 ═══ -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"  Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground"                 Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver"      Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed"          Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled"         Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground"                 Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver"      Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed"          Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled"         Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{StaticResource PaletteNeutral500}" />

            <!-- ═══ 浮层度量（"像 Win11"最关键的一组，与配色无关，深浅主题共用）═══
                 它们是 Fluent 模板【直接引用】的键，覆盖等于给所有弹层统一换壳，
                 不需要碰模板内部，Fluent 升级也不会坏。

                   *ThemePadding        面板 4 / 项 12,0。菜单"挤"的根源就是这两个值太小。
                   MenuBarHeight        顶栏高度，默认 40 会把工具栏撑高，36 与按钮 32 更协调。
                   *Margin              图标列与快捷键的间距；快捷键右对齐靠的就是 InputGestureTextMargin。

                 OverlayCornerRadius 这里【不写字面值】，而是别名到 Metrics 里的 RadiusOverlay ——
                 它是"弹层要不要圆角"的唯一开关，必须在令牌层定义一次，
                 否则会出现"改了 Metrics 却不生效"的诡异现象（本文件后加载，会盖掉令牌层的值）。 -->
            <StaticResource x:Key="OverlayCornerRadius" ResourceKey="RadiusOverlay" />
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePadding">12,0</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,0</Thickness>
            <sys:Double x:Key="MenuBarHeight">36</sys:Double>
            <Thickness x:Key="MenuBarItemPadding">10,0</Thickness>
            <sys:Double x:Key="MenuFlyoutSeparatorThemeHeight">1</sys:Double>
            <Thickness x:Key="MenuFlyoutSeparatorThemePadding">0,4</Thickness>
            <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
            <Thickness x:Key="MenuInputGestureTextMargin">24,0,0,0</Thickness>
            <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>

            <!-- ═══ ToggleButton ═══
                 checked = 实心主色 + 白字；indeterminate = 浅底 + 主色边框 + 主色字，
                 两者刻意长得不一样，因为"确定开启"和"部分开启"是不同含义。 -->
            <SolidColorBrush x:Key="ToggleButtonBackground"                         Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"              Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed"                  Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled"                 Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"                  Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"       Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"           Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled"          Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminate"            Color="{StaticResource PalettePrimary50}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePointerOver" Color="{StaticResource PalettePrimary100}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePressed"     Color="{StaticResource PalettePrimary200}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminateDisabled"    Color="{StaticResource PaletteNeutral100}" />

            <SolidColorBrush x:Key="ToggleButtonBorderBrush"                         Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver"              Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed"                  Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled"                 Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked"                  Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver"       Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed"           Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled"          Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminate"            Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePressed"     Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminateDisabled"    Color="{StaticResource PaletteNeutral300}" />

            <SolidColorBrush x:Key="ToggleButtonForeground"                         Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"              Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed"                  Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled"                 Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked"                  Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"       Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"           Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled"          Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminate"            Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePointerOver" Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePressed"     Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminateDisabled"    Color="{StaticResource PaletteNeutral400}" />

            <!-- ═══ RepeatButton ═══
                 ScrollBar 的滚动箭头就是 RepeatButton —— 不桥接的话，
                 滚动条本体是青蓝、箭头却是 Fluent 灰蓝，拼在一起很脏。 -->
            <SolidColorBrush x:Key="RepeatButtonBackground"             Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver"  Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundPressed"      Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled"     Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrush"            Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrushPointerOver" Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrushPressed"     Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled"    Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="RepeatButtonForeground"             Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver"  Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="RepeatButtonForegroundPressed"      Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="RepeatButtonForegroundDisabled"     Color="{StaticResource PaletteNeutral400}" />

            <!-- ═══ 遗留兼容键（ListBox / TreeView / ProgressBar 仍在引用）═══
                 Fluent 里 ListBoxItem 和 ProgressBar 没有自己的颜色键，走的是这组
                 SystemControl* 老键。不覆盖的话，ListBox 选中项和进度条会顽固地
                 保持 Fluent 蓝 —— 而主程序恰恰用了 ListBox，所以这组必须补。 -->
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"       Color="{StaticResource PalettePrimary50}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush"    Color="{StaticResource PalettePrimary100}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush"      Color="{StaticResource PalettePrimary200}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush"    Color="{StaticResource PalettePrimary50}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="{StaticResource PalettePrimary100}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush"   Color="{StaticResource PalettePrimary200}" />
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush"             Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush"          Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SystemControlHighlightBaseMediumLowBrush"       Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltBaseMediumLowBrush"    Color="{StaticResource PaletteNeutral100}" />

            <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush"        Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush"     Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush"        Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush"  Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"        Color="{StaticResource PaletteNeutral0}" />

            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"       Color="{StaticResource PaletteNeutral800}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="{StaticResource PaletteNeutral700}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"     Color="{StaticResource PaletteNeutral600}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush"  Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"        Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush"         Color="{StaticResource PalettePrimary600}" />

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush"      Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"       Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush"    Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SystemControlDisabledAccentBrush"        Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="{StaticResource PaletteNeutral400}" />

            <SolidColorBrush x:Key="SystemControlTransientBackgroundBrush"  Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="SystemControlTransientBorderBrush"      Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush"   Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource PaletteNeutral0}" />

            <!-- Chrome / Page 族 —— 最后一处漏网纯灰就在这里：
                 浅色实测 #F2F2F2、深色 #171717，ListBox 的底色实际取自 PageBackgroundChromeLow。
                 不补的话，换配色时 ListBox 会永远是那条 Fluent 灰，和周围脱节。 -->
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush"    Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush"   Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundAltHighBrush"     Color="{StaticResource PaletteNeutral50}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush"    Color="{StaticResource PaletteNeutral150}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush"   Color="{StaticResource PaletteNeutral200}" />

        </ResourceDictionary>

        <!-- ════════════════════════════════════════════════════════════════
             深色主题
             ⚠ 不是把浅色值简单反相：暗色界面里"卡片"必须比"页面底"更亮，
               层级靠明度差拉开（所以这里改用 Ink 墨色阶梯，而不是把 Neutral 反序）。
             ════════════════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Dark">

            <!-- ═══ TextBox ═══ -->
            <SolidColorBrush x:Key="TextControlBackground"             Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled"     Color="{StaticResource PaletteInk900}" />

            <SolidColorBrush x:Key="TextControlBorderBrush"            Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled"    Color="{StaticResource PaletteInk700}" />

            <SolidColorBrush x:Key="TextControlForeground"             Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver"  Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused"      Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled"     Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled"    Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource PalettePrimary900}" />

            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <Thickness x:Key="TextControlThemePadding">10,6</Thickness>
            <sys:Double x:Key="TextControlThemeMinHeight">32</sys:Double>

            <!-- ═══ ComboBox ═══ -->
            <SolidColorBrush x:Key="ComboBoxBackground"                     Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"            Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"          Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed"              Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"             Color="{StaticResource PaletteInk900}" />

            <SolidColorBrush x:Key="ComboBoxBorderBrush"                    Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver"         Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"             Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled"            Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused"   Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource PaletteInk500}" />

            <SolidColorBrush x:Key="ComboBoxForeground"                     Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver"          Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed"              Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused"              Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed"       Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled"             Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="ComboBoxDropDownBackground"              Color="{StaticResource PaletteInk800}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush"             Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground"         Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused"  Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="ComboBoxItemBackground"                    Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"         Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed"             Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"            Color="{StaticResource PalettePrimary900}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource PalettePrimary800}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed"     Color="{StaticResource PalettePrimary800}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled"            Color="Transparent" />

            <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>

            <!-- ═══ CheckBox ═══ -->
            <SolidColorBrush x:Key="CheckBoxBackgroundUnchecked"            Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPressed"     Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedDisabled"    Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundChecked"              Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPointerOver"   Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPressed"       Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedDisabled"      Color="Transparent" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked"              Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"   Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"       Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled"      Color="{StaticResource PaletteInk900}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"            Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"     Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled"    Color="{StaticResource PaletteInk700}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked"                Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver"     Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed"         Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled"        Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked"              Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver"   Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed"       Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled"      Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="CheckBoxCheckGlyphFill"         Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphFillDisabled" Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="CheckBoxForeground"             Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver"  Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="CheckBoxForegroundPressed"      Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="CheckBoxForegroundDisabled"     Color="{StaticResource PaletteNeutral500}" />

            <!-- ═══ RadioButton ═══ -->
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill"                     Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver"          Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPressed"              Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillDisabled"             Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke"                   Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver"        Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed"            Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeDisabled"           Color="{StaticResource PaletteInk700}" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill"              Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver"   Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed"       Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled"      Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke"            Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed"     Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled"    Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill"                       Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver"            Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed"                Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled"               Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="RadioButtonForeground"                           Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RadioButtonForegroundPointerOver"                Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RadioButtonForegroundPressed"                    Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RadioButtonForegroundDisabled"                   Color="{StaticResource PaletteNeutral500}" />

            <!-- ═══ Slider ═══ -->
            <SolidColorBrush x:Key="SliderTrackFill"                  Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver"       Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SliderTrackFillPressed"           Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled"          Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="SliderTrackValueFill"             Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver"  Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed"      Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled"     Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="SliderThumbBackground"            Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed"     Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled"    Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="SliderTickBarFill"                Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SliderTickBarFillDisabled"        Color="{StaticResource PaletteInk500}" />
            <CornerRadius x:Key="SliderThumbCornerRadius">9</CornerRadius>

            <!-- ═══ ScrollBar ═══
                 深色下滚动条同样不设底槽，只把滑块提亮到能在深底上看见。 -->
            <SolidColorBrush x:Key="ScrollBarBackground"             Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver"  Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarForeground"             Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ScrollBarThumbFill"              Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver"   Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed"       Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled"      Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ScrollBarButtonBackground"       Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground"  Color="{StaticResource PaletteNeutral300}" />

            <!-- ═══ ToolTip ═══
                 深色下气泡【反相】：浅色底 + 深字。这样在暗界面里依然是最跳的元素。 -->
            <SolidColorBrush x:Key="ToolTipBackground"  Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ToolTipForeground"  Color="{StaticResource PaletteInk950}" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource PaletteNeutral300}" />

            <!-- ═══ Menu / 下拉菜单 ═══ -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"  Color="{StaticResource PaletteInk800}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground"                 Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver"      Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed"          Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled"         Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground"                 Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver"      Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed"          Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled"         Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{StaticResource PaletteNeutral400}" />

            <!-- ═══ 浮层度量（与浅色主题同值：圆角/间距不该随主题变）═══
                 OverlayCornerRadius 同样走别名，理由见浅色主题里的说明。 -->
            <StaticResource x:Key="OverlayCornerRadius" ResourceKey="RadiusOverlay" />
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePadding">12,0</Thickness>
            <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,0</Thickness>
            <sys:Double x:Key="MenuBarHeight">36</sys:Double>
            <Thickness x:Key="MenuBarItemPadding">10,0</Thickness>
            <sys:Double x:Key="MenuFlyoutSeparatorThemeHeight">1</sys:Double>
            <Thickness x:Key="MenuFlyoutSeparatorThemePadding">0,4</Thickness>
            <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
            <Thickness x:Key="MenuInputGestureTextMargin">24,0,0,0</Thickness>
            <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>

            <!-- ═══ ToggleButton ═══ -->
            <SolidColorBrush x:Key="ToggleButtonBackground"                         Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"              Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed"                  Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled"                 Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"                  Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"       Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"           Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled"          Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminate"            Color="{StaticResource PalettePrimary900}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePointerOver" Color="{StaticResource PalettePrimary800}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminatePressed"     Color="{StaticResource PalettePrimary800}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundIndeterminateDisabled"    Color="{StaticResource PaletteInk900}" />

            <SolidColorBrush x:Key="ToggleButtonBorderBrush"                         Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver"              Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed"                  Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled"                 Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked"                  Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver"       Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed"           Color="{StaticResource PalettePrimary600}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled"          Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminate"            Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" Color="{StaticResource PalettePrimary300}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminatePressed"     Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushIndeterminateDisabled"    Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="ToggleButtonForeground"                         Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"              Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed"                  Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled"                 Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked"                  Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"       Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"           Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled"          Color="{StaticResource PaletteNeutral0}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminate"            Color="{StaticResource PalettePrimary300}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePointerOver" Color="{StaticResource PalettePrimary300}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminatePressed"     Color="{StaticResource PalettePrimary300}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundIndeterminateDisabled"    Color="{StaticResource PaletteNeutral500}" />

            <!-- ═══ RepeatButton ═══ -->
            <SolidColorBrush x:Key="RepeatButtonBackground"             Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver"  Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundPressed"      Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled"     Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrush"            Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrushPointerOver" Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrushPressed"     Color="{StaticResource PaletteInk500}" />
            <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled"    Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="RepeatButtonForeground"             Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver"  Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RepeatButtonForegroundPressed"      Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="RepeatButtonForegroundDisabled"     Color="{StaticResource PaletteNeutral500}" />

            <!-- ═══ 遗留兼容键（ListBox / TreeView / ProgressBar）═══ -->
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"       Color="{StaticResource PalettePrimary900}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush"    Color="{StaticResource PalettePrimary800}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush"      Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush"    Color="{StaticResource PalettePrimary900}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="{StaticResource PalettePrimary800}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush"   Color="{StaticResource PalettePrimary700}" />
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush"             Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush"          Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SystemControlHighlightBaseMediumLowBrush"       Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltBaseMediumLowBrush"    Color="{StaticResource PaletteInk700}" />

            <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush"       Color="{StaticResource PaletteInk850}" />
            <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush"    Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush"       Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush" Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"       Color="{StaticResource PaletteInk800}" />

            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"       Color="{StaticResource PaletteNeutral100}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="{StaticResource PaletteNeutral200}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"     Color="{StaticResource PaletteNeutral300}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush"  Color="{StaticResource PaletteNeutral400}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"        Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush"         Color="{StaticResource PalettePrimary300}" />

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush"      Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"       Color="{StaticResource PalettePrimary500}" />
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush"    Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="SystemControlDisabledAccentBrush"        Color="{StaticResource PaletteNeutral500}" />
            <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="{StaticResource PaletteNeutral500}" />

            <SolidColorBrush x:Key="SystemControlTransientBackgroundBrush"  Color="{StaticResource PaletteInk800}" />
            <SolidColorBrush x:Key="SystemControlTransientBorderBrush"      Color="{StaticResource PaletteInk600}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush"   Color="{StaticResource PalettePrimary400}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource PaletteInk950}" />

            <!-- Chrome / Page 族 —— 同浅色主题，这里补掉 ListBox 底色的纯灰来源 -->
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush"    Color="{StaticResource PaletteInk800}" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush"   Color="{StaticResource PaletteInk900}" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundAltHighBrush"     Color="{StaticResource PaletteInk950}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush"    Color="{StaticResource PaletteInk700}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush"   Color="{StaticResource PaletteInk600}" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

