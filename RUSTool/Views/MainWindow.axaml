<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RUSTool.ViewModels"
        xmlns:conv="using:RUSTool.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:debug="using:RUSTool.Views.Debug"
        xmlns:clinical="using:RUSTool.Views.Clinical"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="RUSTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RUSTool"
        Width="1280" Height="720"
        Background="#F2F2F2">

    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
        <conv:ModeStatusToBrushMultiConverter x:Key="ModeStatusToBrush" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ 共享工具栏 ═══ -->
        <Border Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#EBEBEB">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="40">

                <!-- 左：标题 -->
                <TextBlock Text="RUSTool" FontSize="16" FontWeight="Bold"
                           Foreground="#1A1A1A" VerticalAlignment="Center" Margin="16,0,0,0" />

                <!-- 标准菜单栏 -->
                <Menu Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Background="White">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建场景" />
                        <MenuItem Header="打开场景…" />
                        <Separator />
                        <MenuItem Header="退出" />
                    </MenuItem>
                    <MenuItem Header="连接">
                        <MenuItem Header="连接" Command="{Binding Connection.ConnectCommand}" />
                        <MenuItem Header="断开连接" Command="{Binding Connection.DisconnectCommand}" />
                        <MenuItem Header="关闭设备" Command="{Binding Connection.DisableRobotCommand}" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="🔧 工程师模式"
                                  Command="{Binding SwitchToDebugCommand}" />
                        <MenuItem Header="🏥 临床模式"
                                  Command="{Binding SwitchToClinicalCommand}" />
                        <Separator />
                        <MenuItem Header="重置视角" />
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem Header="关于" />
                    </MenuItem>
                </Menu>

                <!-- 右侧：常驻状态 + 安全 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center" Margin="0,0,16,0">

                    <!-- 连接状态灯 -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding Session.IsConnected, Converter={StaticResource BoolToBrush}}" />
                        <TextBlock Text="{Binding Session.ConnectText}" FontSize="12"
                                   Foreground="#616161" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 运动状态（空闲 / 手动 / 扫查中 / 已暂停） -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{StaticResource ModeStatusToBrush}">
                                    <Binding Path="Session.Mode" />
                                    <Binding Path="Session.IsPaused" />
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding Session.ModeText}" FontSize="12"
                                   Foreground="#616161" VerticalAlignment="Center" />
                    </StackPanel>


                    <Rectangle Width="1" Height="20" Fill="#E0E0E0" VerticalAlignment="Center" />

                    <!-- 驱动切换（真实 / 仿真） -->
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Content="真实" Padding="12,6" FontSize="12"
                                Foreground="#616161" Background="#FFFFFF" BorderBrush="#D0D0D0"
                                CornerRadius="6,0,0,6"
                                Command="{Binding Connection.SwitchToDriverCommand}"
                                CommandParameter="0" />
                        <Button Content="仿真" Padding="12,6" FontSize="12"
                                Foreground="#1A73E8" Background="#EAF2FD" BorderBrush="#1A73E8"
                                CornerRadius="0,6,6,0" Margin="-1,0,0,0"
                                Command="{Binding Connection.SwitchToDriverCommand}"
                                CommandParameter="1" />
                    </StackPanel>

                    <Rectangle Width="1" Height="20" Fill="#E0E0E0" VerticalAlignment="Center" />

                    <!-- 急停 -->
                    <Button x:Name="EstopButton" Content="急停" Padding="22,8" FontSize="14"
                            FontWeight="Bold" Foreground="#FFFFFF" Background="#E5484D"
                            BorderBrush="#E5484D" CornerRadius="8"
                            Command="{Binding Control.StopAllMotionCommand}">
                        <Button.Styles>
                            <Style Selector="Button#EstopButton /template/ Border#border">
                                <Setter Property="BoxShadow" Value="0 3 10 #40E5484D" />
                            </Style>
                            <Style Selector="Button#EstopButton:pointerover /template/ Border#border">
                                <Setter Property="Background" Value="#D23C42" />
                                <Setter Property="BorderBrush" Value="#D23C42" />
                            </Style>
                            <Style Selector="Button#EstopButton:pressed /template/ Border#border">
                                <Setter Property="Background" Value="#B92F35" />
                                <Setter Property="BorderBrush" Value="#B92F35" />
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- 急停恢复 -->
                    <Button Content="急停恢复" Padding="14,8" FontSize="14"
                            FontWeight="Bold" Foreground="#FFFFFF" Background="#2E7D32"
                            BorderBrush="#2E7D32" CornerRadius="8"
                            Command="{Binding Control.ResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 内容区（按模式切换） ═══ -->
        <debug:DebugWorkspace Grid.Row="1" IsVisible="{Binding IsDebugMode}" />
        <clinical:ClinicalWorkspace Grid.Row="1" IsVisible="{Binding IsClinicalMode}" />

    </Grid>
</Window>
