<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RUSTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:debug="using:RUSTool.Views.Debug"
        xmlns:clinical="using:RUSTool.Views.Clinical"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="RUSTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RUSTool"
        Width="1280" Height="720"
        Background="#F2F2F2">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ 共享工具栏 ═══ -->
        <Border Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#EBEBEB">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="36">
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建" />
                        <MenuItem Header="打开" />
                        <Separator />
                        <MenuItem Header="退出" />
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem Header="连接" Command="{Binding Robot.ConnectToRobotCommand}" />
                        <MenuItem Header="断开" Command="{Binding Robot.DisconnectFromRobotCommand}" />
                        <Separator />
                        <MenuItem Header="启动" />
                        <MenuItem Header="暂停" />
                        <MenuItem Header="重置" />
                    </MenuItem>
                    <MenuItem Header="模式">
                        <MenuItem Header="🔧 工程师模式"
                                  Command="{Binding SwitchToDebugCommand}" />
                        <MenuItem Header="🏥 临床模式"
                                  Command="{Binding SwitchToClinicalCommand}" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="重置视角" />
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem Header="关于" />
                    </MenuItem>
                </Menu>

                <!-- 右侧状态 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="16" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🔵 仿真模式" FontSize="12" Foreground="#1A73E8" />
                    <Rectangle Width="1" Height="14" Fill="#E0E0E0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="#28A745" VerticalAlignment="Center" />
                        <TextBlock Text="机械臂" FontSize="12" Foreground="#616161" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="#28A745" VerticalAlignment="Center" />
                        <TextBlock Text="力控" FontSize="12" Foreground="#616161" />
                    </StackPanel>
                    <TextBlock Text="FPS 60" FontSize="12" Foreground="#9E9E9E" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 内容区（按模式切换） ═══ -->
        <debug:DebugWorkspace Grid.Row="1" IsVisible="{Binding IsDebugMode}" />
        <clinical:ClinicalWorkspace Grid.Row="1" IsVisible="{Binding IsClinicalMode}" />

    </Grid>
</Window>
