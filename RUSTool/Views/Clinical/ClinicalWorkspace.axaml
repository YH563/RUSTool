<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="850"
             x:Class="RUSTool.Views.Clinical.ClinicalWorkspace"
             Background="#F2F2F2">
    <Grid>
        <Border CornerRadius="8" Background="#FFFFFF" BoxShadow="0 1 3 #1A000000"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="40,30">
            <StackPanel Spacing="12">
                <TextBlock Text="🏥 临床模式" FontSize="24" FontWeight="SemiBold"
                           Foreground="#1A1A1A" HorizontalAlignment="Center" />
                <TextBlock Text="临床使用界面正在建设中…" FontSize="14"
                           Foreground="#9E9E9E" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
