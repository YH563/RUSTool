<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RUSTool.ViewModels"
        xmlns:debug="using:RUSTool.Views.Debug"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="RUSTool.Views.Shell.DebugShell"
        x:DataType="vm:MainViewModel"
        Title="RUSTool - 调试模式"
        Width="1400" Height="850"
        Background="#F2F2F2">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════ Row 0: 菜单栏 + 状态 ═══════ -->
        <Border Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#EBEBEB">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="36">
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建" />
                        <MenuItem Header="打开" />
                        <Separator />
                        <MenuItem Header="退出" />
                    </MenuItem>
                    <MenuItem Header="仿真">
                        <MenuItem Header="启动" />
                        <MenuItem Header="暂停" />
                        <MenuItem Header="重置" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="重置视角" />
                    </MenuItem>
                    <MenuItem Header="工具" />
                    <MenuItem Header="帮助">
                        <MenuItem Header="关于" />
                    </MenuItem>
                </Menu>

                <!-- 右侧状态 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="16" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🔵 仿真模式" FontSize="12" Foreground="#1A73E8" />
                    <Rectangle Width="1" Height="14" Fill="#E0E0E0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="#28A745" VerticalAlignment="Center" />
                        <TextBlock Text="机械臂" FontSize="12" Foreground="#616161" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="#28A745" VerticalAlignment="Center" />
                        <TextBlock Text="力控" FontSize="12" Foreground="#616161" />
                    </StackPanel>
                    <TextBlock Text="FPS 60" FontSize="12" Foreground="#9E9E9E" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ Row 1: 主面板区域（3 列 + GridSplitter） ═══════ -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,4,2*,4,2*" Margin="8,6,8,0">

            <!-- 3D 场景 -->
            <Border MinWidth="300" CornerRadius="8" Background="#FFFFFF" BoxShadow="0 1 3 #1A000000">
                <Grid RowDefinitions="40,*">
                    <Border Padding="16,0,16,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="3D 场景" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="视角: 默认"
                                       Foreground="#9E9E9E" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Rectangle Grid.Row="1" Height="1" Fill="#F0F0F0" VerticalAlignment="Top" />
                    <debug:Scene3DView Grid.Row="1" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" />

            <!-- 超声影像 -->
            <Border Grid.Column="2" MinWidth="200" CornerRadius="8" Background="#FFFFFF"
                    BoxShadow="0 1 3 #1A000000">
                <Grid RowDefinitions="40,*">
                    <Border Padding="16,0,16,0">
                        <TextBlock Text="超声影像" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" VerticalAlignment="Center" />
                    </Border>
                    <Rectangle Grid.Row="1" Height="1" Fill="#F0F0F0" VerticalAlignment="Top" />
                    <debug:UltrasoundView Grid.Row="1" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" Background="Transparent" />

            <!-- 数据曲线 -->
            <Border Grid.Column="4" MinWidth="200" CornerRadius="8" Background="#FFFFFF"
                    BoxShadow="0 1 3 #1A000000">
                <Grid RowDefinitions="40,*">
                    <Border Padding="16,0,16,0">
                        <TextBlock Text="数据曲线" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" VerticalAlignment="Center" />
                    </Border>
                    <Rectangle Grid.Row="1" Height="1" Fill="#F0F0F0" VerticalAlignment="Top" />
                    <debug:ChartPanel Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════ Row 2: 底部控制区（3 列 + GridSplitter） ═══════ -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,4,1*,4,1.5*" Margin="8,4,8,8">

            <!-- 机械臂 -->
            <Border MinWidth="200" CornerRadius="8" Background="#FFFFFF" BoxShadow="0 1 3 #1A000000">
                <Grid RowDefinitions="40,*">
                    <Border Padding="16,0,16,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="机械臂" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="笛卡尔空间"
                                       Foreground="#1A73E8" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Rectangle Grid.Row="1" Height="1" Fill="#F0F0F0" VerticalAlignment="Top" />
                    <debug:ArmControlPanel Grid.Row="1" DataContext="{Binding Robot}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" />

            <!-- 回放（缩窄比例） -->
            <Border Grid.Column="2" MinWidth="160" CornerRadius="8" Background="#FFFFFF"
                    BoxShadow="0 1 3 #1A000000">
                <Grid RowDefinitions="40,*">
                    <Border Padding="16,0,16,0">
                        <TextBlock Text="回放" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" VerticalAlignment="Center" />
                    </Border>
                    <Rectangle Grid.Row="1" Height="1" Fill="#F0F0F0" VerticalAlignment="Top" />
                    <debug:ReplayModule Grid.Row="1" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" Background="Transparent" />

            <!-- 日志 -->
            <Border Grid.Column="4" MinWidth="160" CornerRadius="8" Background="#FFFFFF"
                    BoxShadow="0 1 3 #1A000000">
                <Grid RowDefinitions="40,*">
                    <Border Padding="16,0,16,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="日志" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" VerticalAlignment="Center" />
                            <Button Grid.Column="2" x:Name="ClearLogButton" Content="清空"
                                    FontSize="12" Foreground="#9E9E9E"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" />
                        </Grid>
                    </Border>
                    <Rectangle Grid.Row="1" Height="1" Fill="#F0F0F0" VerticalAlignment="Top" />
                    <debug:LogView Grid.Row="1" x:Name="LogViewer" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
