<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="300"
             x:Class="RUSTool.Views.Debug.ScanWorkflowPanel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <!-- 工作流状态条 -->
        <Border Background="#F5F9FF" CornerRadius="6" Padding="10,8" BorderBrush="#D6E6F8" BorderThickness="1">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="工作流状态" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="待开始" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1A1A1A" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="下一步" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="开始预扫描" FontSize="13" Foreground="#1A73E8"
                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 四步流程 -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">

            <!-- ① 预扫描 -->
            <Border CornerRadius="6" Padding="8,6" Background="#FAFAFA">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#D0D0D0" />
                    <TextBlock Grid.Column="1" Text="① 预扫描" FontSize="13" FontWeight="SemiBold"
                               Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <Button Content="开始" Padding="10,4" FontSize="12" />
                        <Button Content="结束" Padding="10,4" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ② 位姿 -->
            <Border CornerRadius="6" Padding="8,6" Background="#FAFAFA">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#D0D0D0" />
                        <TextBlock Text="起点" FontSize="11" Foreground="#888" VerticalAlignment="Center" />
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#D0D0D0" />
                        <TextBlock Text="终点" FontSize="11" Foreground="#888" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="② 位姿" FontSize="13" FontWeight="SemiBold"
                               Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <Button Content="设为起点" Padding="10,4" FontSize="12" />
                        <Button Content="设为终点" Padding="10,4" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ③ 规划 -->
            <Border CornerRadius="6" Padding="8,6" Background="#FAFAFA">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#D0D0D0" />
                    <TextBlock Grid.Column="1" Text="③ 规划" FontSize="13" FontWeight="SemiBold"
                               Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="开始规划" Padding="10,4" FontSize="12" />
                </Grid>
            </Border>

            <!-- ④ 执行 -->
            <Border CornerRadius="6" Padding="8,6" Background="#FAFAFA">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#D0D0D0" />
                    <TextBlock Grid.Column="1" Text="④ 执行" FontSize="13" FontWeight="SemiBold"
                               Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="执行" Padding="10,4" FontSize="12"
                            Background="#E8F5E9" BorderBrush="#4CAF50" Foreground="#2E7D32" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- 流程控制 + 查询 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="暂停" Padding="10,4" FontSize="12" />
                <Button Content="恢复" Padding="10,4" FontSize="12" />
                <Button Content="停止" Padding="10,4" FontSize="12"
                        Background="#FDE8E8" BorderBrush="#DC3545" Foreground="#DC3545" />
                <Button Content="复位" Padding="10,4" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新状态" Padding="10,4" FontSize="12" />
        </Grid>

    </Grid>
</UserControl>
