<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:Class="RUSTool.Views.Debug.ChartPanel">
    <Grid RowDefinitions="Auto,*">
        <!-- 通道显隐切换 -->
        <WrapPanel Margin="8,6">
            <CheckBox Content="Fx" IsChecked="True" Foreground="#FF4444" Margin="0,0,8,0" />
            <CheckBox Content="Fy" IsChecked="True" Foreground="#44BB44" Margin="0,0,8,0" />
            <CheckBox Content="Fz" IsChecked="True" Foreground="#4444FF" Margin="0,0,8,0" />
            <CheckBox Content="Tx" Foreground="#FF8800" Margin="0,0,8,0" />
            <CheckBox Content="Ty" Foreground="#AA44FF" Margin="0,0,8,0" />
            <CheckBox Content="Tz" Foreground="#44DDDD" Margin="0,0,8,0" />
            <CheckBox Content="偏差" Foreground="#FFDD00" />
        </WrapPanel>

        <!-- 曲线绘制区域 -->
        <Border Grid.Row="1" Background="#FAFAFA" CornerRadius="0,0,6,6"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="数据曲线区域"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#999999" />
        </Border>
    </Grid>
</UserControl>
