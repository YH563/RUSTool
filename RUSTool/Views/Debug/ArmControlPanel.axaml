<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:robotVm="clr-namespace:RUSTool.ViewModels.Robot"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="350"
             x:Class="RUSTool.Views.Debug.ArmControlPanel"
             x:DataType="robotVm:RobotViewModel">
    <Grid ColumnDefinitions="0.75*,Auto,1*" Margin="8">
        <!-- ═══ 左侧：机械臂控制 ═══ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="4, 10">

            <!-- 标题行 -->
            <Border Grid.Row="0" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="控制面板" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="#1A1A1A" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="点动模式" FontSize="12" Foreground="#888888"
                                   VerticalAlignment="Center" />
                        <ComboBox FontSize="13" SelectedIndex="0" VerticalAlignment="Center"
                                  SelectionChanged="OnJogModeChanged">
                            <ComboBoxItem>基坐标系</ComboBoxItem>
                            <ComboBoxItem>工具坐标系</ComboBoxItem>
                            <ComboBoxItem>关节空间</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 点动操作：6 行，每行一个轴 ═══ -->
            <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*,*" Margin="0,0,0,8">

                <!-- X -->
                <Border Grid.Row="0" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelX" Text="X方向" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnXNeg" Content="−" Width="75" Tag="X-" />
                            <Button x:Name="BtnXPos" Content="+" Width="75" Tag="X+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Y -->
                <Border Grid.Row="1" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelY" Text="Y方向" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnYNeg" Content="−" Width="75" Tag="Y-" />
                            <Button x:Name="BtnYPos" Content="+" Width="75" Tag="Y+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Z -->
                <Border Grid.Row="2" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelZ" Text="Z方向" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnZNeg" Content="−" Width="75" Tag="Z-" />
                            <Button x:Name="BtnZPos" Content="+" Width="75" Tag="Z+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A -->
                <Border Grid.Row="3" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelRx" Text="绕X轴旋转" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRxNeg" Content="−" Width="75" Tag="Rx-" />
                            <Button x:Name="BtnRxPos" Content="+" Width="75" Tag="Rx+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- B -->
                <Border Grid.Row="4" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelRy" Text="绕Y轴旋转" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRyNeg" Content="−" Width="75" Tag="Ry-" />
                            <Button x:Name="BtnRyPos" Content="+" Width="75" Tag="Ry+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- C -->
                <Border Grid.Row="5" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelRz" Text="绕Z轴旋转" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRzNeg" Content="−" Width="75" Tag="Rz-" />
                            <Button x:Name="BtnRzPos" Content="+" Width="75" Tag="Rz+" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <!-- 分割线 -->
        <Rectangle Grid.Column="1" Width="1" Fill="#E0E0E0" VerticalAlignment="Stretch" Margin="0,4" />

        <!-- ═══ 右侧：状态信息 ═══ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,*,*,Auto" Margin="4, 10">

            <TextBlock Text="机械臂状态信息" FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="#1A1A1A" Margin="10,0,0,12"/>

            <!-- TCP 位置 -->
            <Border Grid.Row="1" Background="#F8F8F8" CornerRadius="6"  Padding="4" Margin="6,0,0,6" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="TCP 位置" FontSize="12" FontWeight="Bold" Foreground="#444" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="*,*" Margin="0,6,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FlangeX, StringFormat='X: {0:F4} m'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding FlangeRx, StringFormat='Rx: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FlangeY, StringFormat='Y: {0:F4} m'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FlangeRz, StringFormat='Rz: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FlangeZ, StringFormat='Z: {0:F4} m'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FlangeRy, StringFormat='Ry: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 关节角度 -->
            <Border Grid.Row="2" Background="#F8F8F8" CornerRadius="6"  Padding="4" Margin="6,0,0,6" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="关节角度" FontSize="12" FontWeight="Bold" Foreground="#444" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="*,*" Margin="0,6,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Joint1, StringFormat='J1: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Joint2, StringFormat='J2: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Joint3, StringFormat='J3: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Joint4, StringFormat='J4: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Joint5, StringFormat='J5: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Joint6, StringFormat='J6: {0:F2} deg'}" FontSize="13" Margin="2"></TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="#F8F8F8" CornerRadius="6"  Padding="4" Margin="6,0,0,6" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="关节力矩" FontSize="12" FontWeight="Bold" Foreground="#444" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="*,*" Margin="0,6,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Torque1, StringFormat='J1: {0:F2} Nm'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Torque2, StringFormat='J2: {0:F2} Nm'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Torque3, StringFormat='J3: {0:F2} Nm'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Torque4, StringFormat='J4: {0:F2} Nm'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Torque5, StringFormat='J5: {0:F2} Nm'}" FontSize="13" Margin="2"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Torque6, StringFormat='J6: {0:F2} Nm'}" FontSize="13" Margin="2"></TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
                
                <TextBlock Text="已连接" FontSize="11"></TextBlock>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
