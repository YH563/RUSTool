<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RUSTool.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="350"
             x:Class="RUSTool.Views.Debug.ArmControlPanel"
             x:DataType="vm:RobotControlViewModel">
    <Grid ColumnDefinitions="1.0*,Auto,1.2*" Margin="8">
        <!-- ═══ 左侧：机械臂控制 ═══ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="4, 10">

            <!-- 标题行 -->
            <Border Grid.Row="0" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="点动控制" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="#1A1A1A" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="点动模式" FontSize="12" Foreground="#888888"
                                   VerticalAlignment="Center" />
                        <ComboBox FontSize="13" SelectedIndex="0" VerticalAlignment="Center"
                                  SelectionChanged="OnJogModeChanged">
                            <ComboBoxItem>基坐标系</ComboBoxItem>
                            <ComboBoxItem>工具坐标系</ComboBoxItem>
                            <ComboBoxItem>关节空间</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 点动操作：6 行，每行一个轴 ═══ -->
            <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*,*" Margin="0,0,0,8">

                <!-- X -->
                <Border Grid.Row="0" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelX" Text="X方向" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnXNeg" Content="−" Width="75" Tag="X-" />
                            <Button x:Name="BtnXPos" Content="+" Width="75" Tag="X+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Y -->
                <Border Grid.Row="1" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelY" Text="Y方向" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnYNeg" Content="−" Width="75" Tag="Y-" />
                            <Button x:Name="BtnYPos" Content="+" Width="75" Tag="Y+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Z -->
                <Border Grid.Row="2" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelZ" Text="Z方向" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnZNeg" Content="−" Width="75" Tag="Z-" />
                            <Button x:Name="BtnZPos" Content="+" Width="75" Tag="Z+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A -->
                <Border Grid.Row="3" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelRx" Text="绕X轴旋转" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRxNeg" Content="−" Width="75" Tag="Rx-" />
                            <Button x:Name="BtnRxPos" Content="+" Width="75" Tag="Rx+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- B -->
                <Border Grid.Row="4" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelRy" Text="绕Y轴旋转" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRyNeg" Content="−" Width="75" Tag="Ry-" />
                            <Button x:Name="BtnRyPos" Content="+" Width="75" Tag="Ry+" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- C -->
                <Border Grid.Row="5" CornerRadius="6" Margin="0,3" Padding="8,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LabelRz" Text="绕Z轴旋转" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#333" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRzNeg" Content="−" Width="75" Tag="Rz-" />
                            <Button x:Name="BtnRzPos" Content="+" Width="75" Tag="Rz+" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <!-- 分割线 -->
        <Rectangle Grid.Column="1" Width="1" Fill="#E0E0E0" VerticalAlignment="Stretch" Margin="0,4" />

        <!-- ═══ 右侧：运动指令 ═══ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="4, 10">

            <TextBlock Text="运动指令" FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="#1A1A1A" Margin="10,0,0,12"/>

            <!-- MoveJ / MoveL -->
            <StackPanel Grid.Row="1" Spacing="12" Margin="10,0,0,0">

                <StackPanel Spacing="4">
                    <TextBlock Text="关节空间运动" FontSize="12" Foreground="#888888"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="MoveJInput" PlaceholderText="q1,q2,q3,q4,q5,q6"
                                 FontSize="13" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="执行" Margin="6,0,0,0"
                                Command="{Binding MoveJCommand}"
                                CommandParameter="{Binding Text, ElementName=MoveJInput}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="笛卡尔直线运动" FontSize="12" Foreground="#888888"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="MoveLInput" PlaceholderText="x,y,z,rx,ry,rz"
                                 FontSize="13" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="执行" Margin="6,0,0,0"
                                Command="{Binding MoveLCommand}"
                                CommandParameter="{Binding Text, ElementName=MoveLInput}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>

            <!-- 暂停，继续运动 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        Margin="10,12,0,0" HorizontalAlignment="Right">
                <Button Content="暂停" Command="{Binding PauseCommand}"/>
                <Button Content="继续" Command="{Binding ResumeCommand}"/>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
