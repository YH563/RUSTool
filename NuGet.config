<?xml version="1.0" encoding="utf-8"?>
<!--
  本仓库的 NuGet 源表：nuget.org（来自全局配置）+ 本机离线源。

  为什么要有这个文件：RUSTool.Visualization 引用的 RobotSimulation.* 是本地库
  （~/PersonalLibrary/RobotSimulation），改动后要打成新版本先落进 /home/hp/nuget-local-feed，
  再由本解决方案取用。没有它，每台新机器都得手动 `dotnet nuget add source` 一次，
  否则 restore 只去 nuget.org 找、找不到那个版本号就直接失败。

  这里【故意不写 <clear />】：NuGet 会把各级配置里的源合起来，nuget.org 仍然生效，
  本文件只是额外加上离线源 —— 离线源里没有的包（Avalonia、Silk.NET…）照旧从 nuget.org 取。
-->
<configuration>
  <packageSources>
    <add key="local" value="/home/hp/nuget-local-feed" />
  </packageSources>
</configuration>
