<?xml version="1.0" encoding="utf-8"?>
<!--
  本仓库的 NuGet 源表：nuget.org，一个。

  为什么要有这个文件（而不是吃全局配置）：RUSTool.Visualization 引用的 RobotSimulation.*
  是自研库（github.com/YH563/RobotSimulation），它的 0.1.0 / 0.2.0 / 0.2.1 都已发布到
  nuget.org，因此本仓库不需要本机目录或私有源 —— 换机器、上 CI 只要一根网线就能还原。

  <clear /> 是【故意的】：先把各级配置里可能存在的其它源（例如早先手工加的离线目录）
  清掉，再显式登记 nuget.org。这样「包从哪来」由仓库自己决定，而不是由某台机器的历史决定；
  将来若确实要加私有源，请在这里显式 add，不要退回依赖全局配置。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
